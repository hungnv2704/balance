# Server
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://pfm_user:pfm_local_dev_change_me@localhost:5432/pfm_db
PG_POOL_MAX=10

# Auth & Cookies (Replace JWT_ACCESS_SECRET in real environments; min 32 chars)
JWT_ACCESS_SECRET=replace-with-at-least-32-character-random-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MFA_ENCRYPTION_KEY=replace-with-at-least-32-character-random-mfa-key
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Attachments Storage (Optional override; defaults to backend/storage/attachments)
# ATTACHMENT_STORAGE_DIR=./storage/attachments

# Argon2id Parameters (OWASP recommended >= 19 MiB, iterations >= 2)
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1

# Rate Limiting
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_EXPORT_MAX=5
RATE_LIMIT_EXPORT_WINDOW_SECONDS=3600
